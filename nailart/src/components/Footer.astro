---
import { siteConfig } from "../config/site";

const year = new Date().getFullYear();
const navLinks = [
  { label: "Home", href: "#home" },
  { label: "Services", href: "#services" },
  { label: "Gallery", href: "#gallery" },
  { label: "About", href: "#about" },
  { label: "Pricing", href: "#pricing" },
  { label: "FAQ", href: "#faq" },
];
---

<footer class="bg-text text-background">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-heading text-xl font-semibold text-background">{siteConfig.name}</p>
        <p class="mt-1 text-sm italic text-accent">{siteConfig.tagline}</p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-background/70">{siteConfig.description}</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="font-heading text-base font-semibold">Explore</h2>
        <ul class="mt-4 grid grid-cols-2 gap-2 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-background/70 transition-colors hover:text-background">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-heading text-base font-semibold">Contact</h2>
        <ul class="mt-4 space-y-2 text-sm text-background/70">
          <li>
            <a
              href={`https://wa.me/${siteConfig.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-background"
            >
              WhatsApp — {siteConfig.phone}
            </a>
          </li>
          <li>
            <a
              href={siteConfig.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-background"
            >
              Instagram — {siteConfig.instagram}
            </a>
          </li>
          <li class="text-background/70">
            {siteConfig.address}, {siteConfig.city}
          </li>
          <li class="text-background/70">{siteConfig.openingHours}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-background/15 pt-6 text-center text-sm text-background/60">
      © {year} {siteConfig.name}. All Rights Reserved.
    </div>
  </div>
</footer>
