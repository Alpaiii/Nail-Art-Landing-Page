---
import type { Service } from "../data/services";
import { buildWhatsAppUrl } from "../utils/whatsapp";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const bookUrl = buildWhatsAppUrl({ service: service.name });
---

<article class="flex flex-col overflow-hidden rounded-card border border-secondary bg-white/70 transition-shadow duration-300 hover:shadow-lg hover:shadow-text/10">
  <img
    src={service.image}
    alt={`${service.name} — ${service.description}`}
    width="800"
    height="600"
    loading="lazy"
    data-fallback="/images/fallback.svg"
    class="aspect-[4/3] w-full object-cover"
  />
  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-heading text-xl font-semibold">{service.name}</h3>
      <span class="shrink-0 text-sm text-text/55">{service.duration}</span>
    </div>
    <p class="text-sm leading-relaxed text-text/70">{service.description}</p>
    <div class="mt-auto flex items-center justify-between gap-3 pt-3">
      <p class="text-lg font-semibold text-text">
        <span class="text-xs font-normal uppercase tracking-wide text-text/50">From </span>{service.price}
      </p>
      <a href={bookUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary !px-4 !py-2 text-sm">
        Book Now
      </a>
    </div>
  </div>
</article>
