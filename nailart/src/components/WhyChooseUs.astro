---
import { whyItems } from "../data/why";
---

<section id="why" class="section bg-background">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="section-eyebrow">Why Choose Us</p>
      <h2 class="section-title">The Signature standard</h2>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-5 md:grid-cols-4 lg:gap-8">
      {
        whyItems.map((item) => (
          <div class="reveal rounded-card border border-secondary bg-white/60 p-5 text-center lg:p-7">
            <div
              class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-secondary/70 text-primary"
              aria-hidden="true"
            >
              <svg width="26" height="26" viewBox="0 0 24 24" set:html={item.icon} />
            </div>
            <h3 class="mt-4 font-heading text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text/70">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
