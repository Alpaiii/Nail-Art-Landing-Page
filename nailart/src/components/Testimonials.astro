---
import { testimonials } from "../data/testimonials";

function starRow(rating: number) {
  return Array.from({ length: 5 }, (_, i) => i < rating);
}
---

<section id="testimonials" class="section bg-secondary/40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="section-eyebrow">Testimonials</p>
      <h2 class="section-title">Loved by our clients</h2>
    </div>

    <div
      class="reveal mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 md:grid md:grid-cols-2 md:overflow-visible md:pb-0 lg:grid-cols-3 [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-primary/40"
    >
      {
        testimonials.map((t) => (
          <figure class="flex w-80 shrink-0 snap-center flex-col rounded-card border border-secondary bg-white/70 p-6 md:w-auto">
            <div class="flex text-accent" aria-hidden="true">
              {starRow(t.rating).map((filled) => (
                <svg width="18" height="18" viewBox="0 0 24 24" fill={filled ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z" />
                </svg>
              ))}
            </div>
            <span class="sr-only">{t.rating} out of 5 stars</span>

            <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-text/80">
              <p>“{t.message}”</p>
            </blockquote>

            <figcaption class="mt-5 flex items-center gap-3 border-t border-secondary pt-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary font-heading text-sm text-text"
                aria-hidden="true"
              >
                {t.name.charAt(0)}
              </span>
              <span>
                <span class="block text-sm font-medium text-text">{t.name}</span>
                {t.service && <span class="block text-xs text-text/55">{t.service}</span>}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
