<div
  id="lightbox"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-text/85 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-title"
>
  <div
    class="relative flex max-h-[92vh] w-full max-w-3xl flex-col overflow-y-auto rounded-card bg-background p-4 shadow-2xl sm:p-6"
  >
    <button
      id="lightbox-close"
      type="button"
      class="absolute right-3 top-3 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-background/90 text-text shadow-md transition-colors hover:bg-secondary"
      aria-label="Close image"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <img
      id="lightbox-img"
      src=""
      alt=""
      width="800"
      height="800"
      class="mx-auto max-h-[55vh] w-auto rounded-lg object-contain"
    />

    <div class="mt-5 flex flex-col items-center text-center">
      <p id="lightbox-category" class="section-eyebrow !mb-1"></p>
      <h3 id="lightbox-title" class="font-heading text-2xl font-semibold"></h3>
      <p id="lightbox-price" class="mt-1 hidden text-sm text-text/60"></p>
      <a
        id="lightbox-book"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary mt-5 w-full sm:w-auto"
      >
        Book This Design
      </a>
    </div>

    <div class="mt-4 flex items-center justify-center gap-3">
      <button
        id="lightbox-prev"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-secondary text-text transition-colors hover:bg-secondary"
        aria-label="Previous design"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>
      <button
        id="lightbox-next"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-secondary text-text transition-colors hover:bg-secondary"
        aria-label="Next design"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>
    </div>
  </div>
</div>
