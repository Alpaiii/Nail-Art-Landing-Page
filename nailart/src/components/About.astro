---
import { aboutContent } from "../data/about";
import Stats from "./Stats.astro";

const { eyebrow, title, paragraphs, artistName, artistRole, image, imageAlt, stats, showStats } =
  aboutContent;
---

<section id="about" class="section bg-background">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <img
          src={image}
          alt={imageAlt}
          width="800"
          height="900"
          loading="lazy"
          class="aspect-[8/9] w-full rounded-card object-cover shadow-lg shadow-text/10"
        />
      </div>

      <div class="reveal">
        <p class="section-eyebrow">{eyebrow}</p>
        <h2 class="section-title">{title}</h2>
        <div class="space-y-4 text-text/75">
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-7 flex items-center gap-4">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-secondary font-heading text-lg text-text"
            aria-hidden="true"
          >
            SN
          </div>
          <div>
            <p class="font-medium text-text">{artistName}</p>
            <p class="text-sm text-text/60">{artistRole}</p>
          </div>
        </div>
      </div>
    </div>

    {showStats && (
      <div class="reveal mt-14">
        <Stats stats={stats} />
      </div>
    )}
  </div>
</section>
