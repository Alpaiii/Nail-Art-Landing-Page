---
import { siteConfig } from "../config/site";

const menu = [
  { label: "Home", href: "#home" },
  { label: "Services", href: "#services" },
  { label: "Gallery", href: "#gallery" },
  { label: "About", href: "#about" },
  { label: "Pricing", href: "#pricing" },
  { label: "FAQ", href: "#faq" },
];
---

<header id="navbar" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:h-20 lg:px-8" aria-label="Main">
    <a href="#home" class="flex shrink-0 items-center" aria-label={`${siteConfig.name} — home`}>
      <img src={siteConfig.logo} alt={siteConfig.name} class="h-10 w-auto lg:h-12" />
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        menu.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-text/80 transition-colors hover:text-text"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href="#booking" class="btn btn-primary !px-3 !py-2 text-sm sm:!px-5 sm:!py-2.5">
        <span class="sm:hidden">Book Now</span>
        <span class="hidden sm:inline">Book Appointment</span>
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="relative z-[60] inline-flex h-11 w-11 items-center justify-center rounded-lg text-text md:hidden"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="hidden">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-overlay" class="fixed inset-0 z-40 hidden bg-text/40 md:hidden"></div>
  <div
    id="mobile-menu"
    class="fixed right-0 top-0 z-50 flex h-full w-72 max-w-[85%] translate-x-full flex-col gap-2 bg-background p-6 shadow-2xl transition-transform duration-300 md:hidden"
    aria-label="Mobile"
    inert
  >
    <div class="mb-6 flex items-center justify-between">
      <img src={siteConfig.logo} alt="" class="h-10 w-auto" />
    </div>
    <ul class="flex flex-col gap-1">
      {
        menu.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-link block rounded-lg px-3 py-3 text-base font-medium text-text transition-colors hover:bg-secondary/60"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="#booking" class="mobile-link btn btn-primary mt-6 w-full">Book Appointment</a>
    <a
      href={`https://wa.me/${siteConfig.whatsapp}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-outline mt-3 w-full"
    >
      Chat on WhatsApp
    </a>
  </div>
</header>

<style>
  #navbar {
    background-color: transparent;
    box-shadow: none;
  }

  #navbar.scrolled {
    background-color: rgb(255 249 247 / 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 0 rgb(43 37 37 / 0.06), 0 6px 20px rgb(43 37 37 / 0.06);
  }
</style>

<script>
  const header = document.getElementById("navbar")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const overlay = document.getElementById("mobile-overlay")!;
  const iconOpen = document.getElementById("icon-open")!;
  const iconClose = document.getElementById("icon-close")!;

  const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 50);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.classList.toggle("translate-x-full", !open);
    menu.toggleAttribute("inert", !open);
    overlay.classList.toggle("hidden", !open);
    // Prevent keyboard focus escaping to the page behind the open drawer
    document.querySelector("main")?.toggleAttribute("inert", open);
    document.querySelector("footer")?.toggleAttribute("inert", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
    document.body.style.overflow = open ? "hidden" : "";
    if (open) menu.querySelector<HTMLElement>("a")?.focus();
  };

  toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  overlay.addEventListener("click", () => setOpen(false));
  menu.querySelectorAll(".mobile-link").forEach((link) =>
    link.addEventListener("click", () => setOpen(false))
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
